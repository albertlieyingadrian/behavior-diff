# The README's demo GIF. Record from the repo root, with the repo venv installed: vhs examples/videos/demo.tape
Output docs/images/demo.gif
Output docs/videos/demo.mp4
Set Shell zsh
Set FontSize 18
Set Width 1180
Set Height 520
Set Padding 26
Set TypingSpeed 35ms
Set Theme {"name":"tide","background":"#0f1413","foreground":"#e6efec","cursor":"#3fb3a1","selection":"#1f3a35","black":"#0f1413","red":"#e07a6f","green":"#7fd1a8","yellow":"#e8c37a","blue":"#7fb0e0","magenta":"#3fb3a1","cyan":"#9fe0d5","white":"#d5dfdc","brightBlack":"#6b7a76","brightRed":"#f0a59c","brightGreen":"#a8e6c4","brightYellow":"#f2d9a5","brightBlue":"#a9cbef","brightMagenta":"#7fd8c9","brightCyan":"#c6f0e8","brightWhite":"#ffffff"}
Hide
Type `export PATH=$PWD/.venv/bin:$PATH PS1='%F{43}behavior-diff%f $ ' && setopt interactivecomments && cd $(mktemp -d) && clear`
Enter
Sleep 1s
Show
Type "# pip install bdiff"
Enter
Sleep 600ms
Type "bdiff demo    # a bullet-point LoRA on Qwen3-8B, from saved data: no key needed"
Sleep 500ms
Enter
Sleep 7s
Type "# 5 of 14 behaviors changed; the base against itself: 0 of 14"
Enter
Sleep 4s
